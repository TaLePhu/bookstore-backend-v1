# Application
NODE_ENV=development
PORT=3000
APP_NAME=BookStore Backend
LOG_LEVEL=debug

# Database
# Use DATABASE_URL in production, or DB_* fields for local/docker.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=bookstore
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

# JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=7d

# Security
BCRYPT_ROUNDS=10

# CORS (comma-separated when deploy has multiple frontend domains)
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX_REQUESTS=100

# Redis (BullMQ)
REDIS_URL=redis://red-d844qsrtqb8s73f0sc5g:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FAMILY=4
SMTP_USER=
SMTP_PASS=
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Email
EMAIL_FROM=BookStore <your-verified-sender@example.com>
MAILERSEND_API_TOKEN=

# Gmail API (preferred on Render when configured)
# OAuth scope: https://www.googleapis.com/auth/gmail.send
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=your-gmail-address@gmail.com

# Database reset safety (optional)
# FORCE_RESET_DB=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_name
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret
CLOUDINARY_FOLDER=books

# Gemini Embeddings
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1beta
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# MoMo payment gateway
MOMO_DEMO_MODE=true
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

