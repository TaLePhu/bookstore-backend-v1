# Application
NODE_ENV=development
PORT=3000
APP_NAME=BookStore Backend
LOG_LEVEL=debug

# Database
# Use DATABASE_URL in production, or DB_* fields for local/docker.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=bookstore
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

# JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=7d

# Security
BCRYPT_ROUNDS=10

# CORS (comma-separated when deploy has multiple frontend domains)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX_REQUESTS=100

# Redis (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Database reset safety (optional)
# FORCE_RESET_DB=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_name
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret
CLOUDINARY_FOLDER=books

# Gemini Embeddings
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1
